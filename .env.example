# Public browser-reachable API origin only; no passwords, tokens or S3 keys.
# Set this before npm run dev / npm run build. Rebuild to change a production URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# UI opt-in for trusted local testers only; only loopback API origins are accepted.
# Does NOT enable the backend: it separately needs LOCAL_TEST_ACCOUNT_ENABLE=true.
# Never enable on a publicly accessible demo or production API.
NEXT_PUBLIC_LOCAL_TEST_LOGIN_ENABLED=false
