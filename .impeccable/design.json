  "narrative": {
    "northStar": "Light Industrial Customer Workspace",
    "overview": "The approved Customer world is calm, practical and light industrial: white document surfaces, charcoal text and burnt-orange actions support Thai task completion. This names the approved direction rather than introducing a new visual concept.\n\nThe frontmatter and the eight canonical sections here apply only to the authenticated Customer surface. Staff, Admin, Landing and Auth retain their existing visual systems and specifications below. Source authority is `src/features/customer/customer.module.css` and `customer-shell.tsx`; the frontmatter records reused light-theme primitives, while the stylesheet remains authoritative for dark overrides and complete component states.",
    "keyCharacteristics": [
      "Thai-first readable typography.",
      "Task-specific layouts with clear document and status hierarchy.",
      "Flat surfaces, restrained borders and explicit actions."
    ],
    "rules": [
      {
        "name": "The Surface Scope Rule",
        "body": "Customer tokens must not replace Staff, Admin, Landing or Auth tokens.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep Customer typography, palette and layout scoped to the authenticated Customer workspace.",
      "Do distinguish request, quotation, evidence, job, delivery and invoice states in both copy and layout.",
      "Do preserve keyboard focus, native dialog behavior and explicit loading, empty, error and partial-data states."
    ],
    "donts": [
      "Don't expose staff costs, stock or supplier data to decorate Customer views.",
      "Don't describe mock browser checks as live backend verification.",
      "Don't persist session tokens, signed links or transient retry payloads in browser storage."
    ]
  }
